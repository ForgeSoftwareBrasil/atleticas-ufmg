# Quando "true", as chamadas à API central são respondidas pelos mocks MSW em memória
# (src/nucleo/mocks). Com "false", o servidor Next chama a API real em API_URL.
API_MOCK=true

# URL base da API central (sem /v1 e sem barra final).
API_URL=https://api.mock.local

# Identificador desta atlética na API central.
ATLETICA_ID=hermes-face

# Segredo usado para cifrar o cookie de sessão (mínimo de 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
